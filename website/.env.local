# Where the commerce API lives.
#
# Server components fetch this directly. The browser never uses it — client
# requests go to /api/... on this same origin and Next rewrites them, so there
# is no CORS story and no API host baked into the HTML.
API_BASE_URL=http://localhost:5055

# Used for canonical URLs, sitemap entries and Open Graph tags.
SITE_URL=http://localhost:3100
