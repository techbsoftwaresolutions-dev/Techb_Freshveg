diff --git a/website/app/globals.css b/website/app/globals.css
index 40c9793..c9f6b64 100644
--- a/website/app/globals.css
+++ b/website/app/globals.css
@@ -6463,3 +6463,32 @@ body:has(.help-page) .search-form { display: none; }
   .catbar-all-icon { width: 19px; height: 19px; }
 }
 
+
+
+/* Hero alignment: copy sits on a solid panel at the left, the photo fills the right
+   and fades into it, so headlines never run over the picture. */
+@media (min-width: 601px) {
+  .market-photo { left: 34%; width: auto; -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 22%); mask-image: linear-gradient(90deg, transparent 0, #000 22%); }
+  .market-photo > img { object-position: 60% 50%; }
+  .market-copy { width: min(50%, 640px); background: linear-gradient(90deg, #f3f3df 0%, #f3f3df 82%, rgba(243,243,223,0) 100%); }
+  .market-copy h1 { max-width: 13ch; }
+  .market-seal { right: 4%; bottom: 7%; }
+}
+
+
+/* Six departments now (Fruits and Vegetables are separate): rows stay one tidy line. */
+@media (min-width: 1081px) {
+  .home-main .shop-row { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 20px 14px; }
+  .home-main .top-cats { gap: 14px; }
+  .home-main .top-cats > .top-cat { flex: 1 1 0; min-width: 118px; }
+  .home-main .top-cat-name { font-size: 14px; }
+}
+/* Offer cards: one-line-friendlier headings, copy and photo evenly split, buttons on one baseline. */
+.home-main .promo { min-height: 172px; align-items: stretch; }
+.home-main .promo:has(.promo-image) .promo-copy { max-width: 56%; }
+.home-main .promo h3 { font-size: 18px; line-height: 1.22; }
+.home-main .promo-image { width: 46%; object-position: center; }
+.home-main .promo-badge { font-size: 14px; }
+.home-main .promo p { font-size: 12px; margin: 6px 0 12px; }
+/* Product rows with fewer cards than columns keep the same card width, left-aligned. */
+.home-main .rail { justify-content: start; }
