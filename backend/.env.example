# --- Server ---
PORT=5055
NODE_ENV=development
# Development only: every phone number logs in with this one fixed OTP (also shown
# on the login screens). Ignored in production. Use "off" for random codes.
DEV_FIXED_OTP=482915
API_PREFIX=/api/v1

# --- Live addresses (Hosur Basket) ---
#   https://hosurbasket.com        website
#   https://admin.hosurbasket.com  admin panel
#   https://hosurbasket.com    this API
# Browsers on any other site are refused. Leave empty in development to allow
# every origin (localhost:5180, :3100, Expo web, …).
# CORS_ORIGINS=https://hosurbasket.com,https://www.hosurbasket.com,https://admin.hosurbasket.com
CORS_ORIGINS=

# --- Database ---
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/commerce_engine
#
# MongoDB Atlas — note the database name after the host. Atlas does not put one
# in the URI it gives you, and without it the driver connects to "test", so the
# seed lands somewhere you did not expect:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/commerce_engine?retryWrites=true&w=majority
#
# Atlas also refuses connections from IPs that are not on the cluster's access
# list (Atlas -> Network Access). That surfaces as "could not connect to any
# servers in your MongoDB Atlas cluster", not as an auth error.
#
# "querySrv ECONNREFUSED" instead means Node could not do the SRV lookup for
# mongodb+srv:// (common on Windows, where Node can fall back to 127.0.0.1 as
# its DNS server). Point it at real resolvers:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Auth ---
# In production these have no fallback: the API refuses to start without them,
# rather than signing tokens with a secret that is published in this file.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-and-make-it-different
JWT_REFRESH_EXPIRES_IN=30d

# --- Cache (optional; the API runs fine without Redis) ---
REDIS_URL=

# --- Storefront defaults ---
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# --- Image storage (Cloudinary only — required for uploads) ---
# Every uploaded image goes to Cloudinary; nothing is stored on this server's
# disk. All three keys must be set or uploads are refused with a 503 naming
# what is missing. CLOUDINARY_FOLDER is the root every upload goes under, so
# one account can hold several projects.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- Razorpay (UPI / cards / netbanking) ---
# Create keys in the Razorpay dashboard (Test mode first). With both set, the
# website checkout shows "Pay with Razorpay" under UPI. The webhook secret is
# optional: set it if you add a webhook to <your-api>/api/v1/payments/webhook/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- SMS login codes (required in production) ---
# Without a provider the live site cannot text a code, so customers never get
# one — the code is only shown on screen in development. Pick one:
#   SMS_PROVIDER=msg91     needs MSG91_AUTH_KEY + MSG91_TEMPLATE_ID (DLT-approved OTP template with ##OTP##)
#   SMS_PROVIDER=fast2sms  needs FAST2SMS_API_KEY
#   SMS_PROVIDER=twilio    needs TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN + TWILIO_FROM (or TWILIO_MESSAGING_SERVICE_SID)
# SMS_PROVIDER=
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# FAST2SMS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_MESSAGING_SERVICE_SID=
# Optional: numbers that always sign in with a fixed 6-digit code and are never
# texted (your own phone, app-store reviewers). number:code, comma separated.
# OTP_TEST_NUMBERS=7894561230:482915
# OTP_TEST_NUMBERS=

# Testing only: with no SMS provider set, show the login code on screen for any
# customer number. Anyone could sign in as any number — remove before launch.
# OTP_SHOW_CODE=true
