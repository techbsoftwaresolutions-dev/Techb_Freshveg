# --- Server ---
PORT=5055
NODE_ENV=development
API_PREFIX=/api/v1

# --- Live addresses (The Farmers Basket) ---
#   https://thefarmersbasket.in        website
#   https://admin.thefarmersbasket.in  admin panel
#   https://thefarmersbasket.in    this API
# Browsers on any other site are refused. Leave empty in development to allow
# every origin (localhost:5180, :3100, Expo web, …).
# CORS_ORIGINS=https://thefarmersbasket.in,https://www.thefarmersbasket.in,https://admin.thefarmersbasket.in
CORS_ORIGINS=

# --- Database ---
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/commerce_engine
#
# MongoDB Atlas — note the database name after the host. Atlas does not put one
# in the URI it gives you, and without it the driver connects to "test", so the
# seed lands somewhere you did not expect:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/commerce_engine?retryWrites=true&w=majority
#
# Atlas also refuses connections from IPs that are not on the cluster's access
# list (Atlas -> Network Access). That surfaces as "could not connect to any
# servers in your MongoDB Atlas cluster", not as an auth error.
#
# "querySrv ECONNREFUSED" instead means Node could not do the SRV lookup for
# mongodb+srv:// (common on Windows, where Node can fall back to 127.0.0.1 as
# its DNS server). Point it at real resolvers:
# DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Auth ---
# In production these have no fallback: the API refuses to start without them,
# rather than signing tokens with a secret that is published in this file.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-too-and-make-it-different
JWT_REFRESH_EXPIRES_IN=30d

# --- Storefront defaults ---
DEFAULT_CURRENCY=INR
DEFAULT_COUNTRY=IN

# --- Image storage (Cloudinary only — required for uploads) ---
# Every uploaded image goes to Cloudinary; nothing is stored on this server's
# disk. All three keys must be set or uploads are refused with a 503 naming
# what is missing. CLOUDINARY_FOLDER is the root every upload goes under, so
# one account can hold several projects.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# --- WhatsApp order updates (Meta WhatsApp Cloud API) — see docs/WHATSAPP.md ---
# Off by default. The API starts and orders work with all of these empty;
# set WHATSAPP_ENABLED=true only once every required value below is filled.
# Put real values in .env (never in this file, never in git).
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# The Graph API version to call, e.g. v23.0 — use one Meta currently supports
# (developers.facebook.com/docs/graph-api/changelog).
WHATSAPP_API_VERSION=
# Approved template names, one per order update. Leave one empty to not send it.
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_PACKED=
WHATSAPP_TEMPLATE_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_ORDER_DELIVERED=
WHATSAPP_TEMPLATE_ORDER_CANCELLED=
# The language the templates were approved in (en, en_US, hi, ...).
WHATSAPP_TEMPLATE_LANGUAGE=en
# Prefixed to the 10-digit numbers customer accounts store.
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Delivery receipts webhook: {API}/api/v1/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# The customer website, for the order link in messages, e.g. https://thefarmersbasket.in
FRONTEND_URL=

# --- Online payments (Razorpay) ---
# Off until both keys are set AND Admin -> Settings -> Payments has "Online
# payment" ticked with Gateway = Razorpay; until then checkout offers only cash
# on delivery / UPI-to-store. Use test keys (rzp_test_...) until you go live.
# Put real values in .env (never in this file, never in git). Only the key id is
# ever sent to the website/app (inside the checkout payload); the secret and the
# webhook secret stay on this server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Dashboard -> Webhooks: URL {API}/api/v1/payments/webhook/razorpay,
# events payment.captured, payment.failed, order.paid, and this same secret.
RAZORPAY_WEBHOOK_SECRET=

# The storefront's public address, e.g. https://thefarmersbasket.in — referral
# share links are built from it (${PUBLIC_WEBSITE_URL}/?ref=CODE). Optional:
# without it the website uses its own origin and the app a built-in default.
PUBLIC_WEBSITE_URL=
