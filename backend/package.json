{
  "name": "commerce-engine-api",
  "version": "0.1.0",
  "private": true,
  "description": "Configurable commerce engine API — catalog, inventory, cart, orders",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seed/run.js",
    "seed:reset": "node src/seed/run.js --reset",
    "sync-indexes": "node src/seed/syncIndexes.js",
    "smoke": "node src/seed/smoke.js",
    "demo": "node src/seed/demoServer.js",
    "jobs:run": "node -e \"require(\"./src/jobs/scheduler\").trigger(process.argv[1]).then(r=>console.log(r))\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
