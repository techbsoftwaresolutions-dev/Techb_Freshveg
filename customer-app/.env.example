# Where the commerce API lives.
#
# Live app (Play Store / App Store build):
#   API_BASE_URL=https://thefarmersbasket.in
#
# Development: on a simulator or `expo start --web`, localhost reaches your
# machine. On a physical phone running Expo Go it does NOT — use your
# computer's LAN IP, e.g. API_BASE_URL=http://192.168.1.20:5055
# API_BASE_URL=https://thefarmersbasket.in
