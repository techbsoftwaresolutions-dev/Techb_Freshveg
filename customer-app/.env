# Where the commerce API lives.
#
# On a simulator or `expo start --web`, localhost reaches your machine.
# On a physical phone running Expo Go it does NOT — use your computer's LAN IP,
# e.g. API_BASE_URL=http://192.168.1.20:5055
# Leave unset in development: the app reaches the API on the computer running
# `npx expo start` by itself. Set it only to use another server.
# API_BASE_URL=http://192.168.1.35:5055
