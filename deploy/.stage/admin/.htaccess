# Apache (cPanel / Hostinger shared hosting) rules for the admin panel.
# Vite copies this file into dist/ on every build, so it is uploaded with the
# rest of the admin.
#
# The admin is a single-page app: /catalog/products/123 is not a real file on
# the server, it is a screen inside index.html. Without this, refreshing any
# page other than the home page gives a 404.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and folders (index.html, /assets/...) as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is a screen inside the app.
  RewriteRule ^ index.html [L]
</IfModule>

# The built files in /assets have content hashes in their names and never
# change, so browsers may keep them; index.html must always be fetched fresh
# so a new upload takes effect straight away.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
